<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- USB Permissions for OBD-II Adapters -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    
    <!-- Bluetooth Permissions for Wireless OBD-II -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    
    <!-- Location for BLE scanning (required on newer Android) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    
    <!-- Network for data export -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- Storage for logs and exports -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" 
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    
    <!-- Foreground service for persistent connections -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    
    <!-- Wake lock to keep processing during tests -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Library manifest: no <application> attributes (icon/label/theme/name) so
         nothing conflicts when merged into :app. The toolkit screen is launched
         in-process from Workshop; it keeps the USB-attached filter but no LAUNCHER. -->
    <application>

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CarHackerKit">

            <!-- USB Device Attached -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <!--
            NOTE: OBDService / CANMonitorService were declared here but never
            implemented (no such classes exist in the codebase), which would
            crash at runtime if ever started. Removed until they are actually
            implemented. The FOREGROUND_SERVICE permissions above are retained
            for when they are re-added.
        -->

    </application>

</manifest>
