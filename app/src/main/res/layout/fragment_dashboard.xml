<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- ── Header bar ─────────────────────────────────── -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/header_bg"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- Checkered-flag left accent -->
        <ImageView
            android:id="@+id/flag_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/checkered_flag_bg"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_marginEnd="8dp" />

        <!-- Vehicle name -->
        <TextView
            android:id="@+id/vehicle_name_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vehicle"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/flag_icon"
            style="@style/RacingTextTitle"
            android:textSize="16sp" />

        <!-- Live status pill -->
        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="○ NO SIGNAL"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/surina_label"
            android:layout_marginEnd="12dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:textColor="#FF3333" />

        <!-- SURINA watermark — small, classy, always visible -->
        <TextView
            android:id="@+id/surina_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SURINA"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:textSize="11sp"
            android:textStyle="italic"
            android:fontFamily="sans-serif-light"
            android:textColor="#888888"
            android:letterSpacing="0.18" />

    </RelativeLayout>

    <!-- Red separator line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/racing_red" />

    <!-- ── Gauges grid ────────────────────────────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/gauges_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:clipToPadding="false" />

</LinearLayout>
